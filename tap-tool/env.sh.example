#!/bin/sh
# 点选工具配置示例
#
# 用法：
#   cp env.sh.example env.sh
#   vi env.sh            # 填你自己的地址和密钥
#   . ./env.sh
#   python serve.py

# ---- ADB ----
# adb 可执行文件路径。留空用系统 PATH 里的。
export ADB_PATH="adb"

# 目标设备序列号。留空自动选第一台在线设备。
export ADB_SERIAL=""

# ---- 服务器 ----
# 运行中转服务的机器地址。
# 推荐用 HTTPS（8788）；如果服务器只开了 HTTP，改成 http://...:8787
export BILIAUTO_SERVER="https://YOUR_SERVER_HOST:8788"

# 配对密钥：服务器上 ~/.config/biliauto/pairing.key 的内容
# 留空则不做同步，只保存到本地
export BILIAUTO_KEY=""

# 点位归属的应用包名（如 com.tencent.mobileqq）
# 留空表示全局，所有应用都能看到
export BILIAUTO_APP=""
