<?xml version="1.0" encoding="utf-8"?>
<!--
  信任树莓派的自签证书。
  WebView 在 TLS 握手阶段就会拒绝未知 CA，onReceivedSslError 根本不会被调用，
  所以只能在这里把 Pi 的证书显式列为信任锚。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/pi_cert" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">YOUR_SERVER_IPV6</domain>
        <domain includeSubdomains="true">YOUR_SERVER_HOST</domain>
        <domain includeSubdomains="true">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/pi_cert" />
        </trust-anchors>
    </domain-config>
</network-security-config>
